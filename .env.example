# Application Settings
APP_NAME=Bulk Certificate Generator API
APP_VERSION=1.0.0
DEBUG=false

# Database Configuration (SQLite default; PostgreSQL example: postgresql://user:password@localhost:5432/certdb)
DATABASE_URL=sqlite:///./certificates.db

# Storage Directory for Generated PDF Files
STORAGE_DIR=storage/certificates

# Base URL for Verification Links and QR codes
BASE_URL=http://localhost:8000

# Batch limits
MAX_BATCH_SIZE=1000
